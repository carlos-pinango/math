<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visualiseur de Probabilité Conditionnelle</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        input[type=range] {
            cursor: pointer;
        }
        .fraction {
            display: inline-flex;
            flex-direction: column;
            vertical-align: middle;
            text-align: center;
            font-size: 1.1rem;
            margin: 0 5px;
        }
        .numerator {
            border-bottom: 2px solid #374151;
            padding: 0 5px;
        }
        .denominator {
            padding: 0 5px;
        }
        .math-font {
            font-family: "Cambria Math", "Times New Roman", serif;
            font-style: italic;
        }
        .transition-geom {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">

    <div class="max-w-5xl mx-auto p-4 md:p-8">
        <header class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-indigo-900 mb-2">Probabilité Conditionnelle</h1>
            <p class="text-slate-500 italic">Univers Ω (Aire = 1.0) | Événements A et B (Aire max = 0.15)</p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- PANNEAU DE CONTRÔLE -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col gap-6">
                <h2 class="text-xl font-semibold flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    Paramètres
                </h2>
                
                <div class="space-y-4">
                    <div>
                        <label class="flex justify-between text-sm font-medium mb-1 text-indigo-700">
                            <span>P(A)</span>
                            <span id="valA" class="font-bold font-mono text-base">0.15</span>
                        </label>
                        <input type="range" id="sliderA" min="0.01" max="0.15" step="0.01" value="0.15" class="w-full h-2 bg-indigo-100 rounded-lg appearance-none accent-indigo-600">
                    </div>

                    <div>
                        <label class="flex justify-between text-sm font-medium mb-1 text-emerald-700">
                            <span>P(B)</span>
                            <span id="valB" class="font-bold font-mono text-base">0.12</span>
                        </label>
                        <input type="range" id="sliderB" min="0.01" max="0.15" step="0.01" value="0.12" class="w-full h-2 bg-emerald-100 rounded-lg appearance-none accent-emerald-600">
                    </div>

                    <div>
                        <label class="flex justify-between text-sm font-medium mb-1 text-purple-700">
                            <span>P(A ∩ B)</span>
                            <span id="valInter" class="font-bold font-mono text-base">0.05</span>
                        </label>
                        <input type="range" id="sliderInter" min="0" max="0.12" step="0.01" value="0.05" class="w-full h-2 bg-purple-100 rounded-lg appearance-none accent-purple-600">
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100">
                    <button id="toggleBtn" class="w-full py-3 px-4 rounded-xl font-bold bg-slate-200 text-slate-700 hover:bg-slate-300 transition-all flex items-center justify-center gap-2 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="m21 3-7 7"/><path d="M9 21H3v-6"/><path d="m3 21 7-7"/></svg>
                        <span>Appliquer la condition (Sachant B)</span>
                    </button>
                </div>

                <!-- FORMULE -->
                <div class="bg-indigo-50 p-5 rounded-xl border border-indigo-100">
                    <div class="flex items-center justify-center text-slate-800 math-font mb-4">
                        <span>P(A | B) = </span>
                        <div class="fraction">
                            <span class="numerator">P(A ∩ B)</span>
                            <span class="denominator">P(B)</span>
                        </div>
                    </div>
                    <div class="text-center text-indigo-700 font-mono text-xl pt-4 border-t border-indigo-200">
                        <span id="calcFormula">0.05 / 0.12</span> = <span id="finalResult" class="font-bold text-2xl">0.417</span>
                    </div>
                </div>
            </div>

            <!-- VISUALISATION SVG -->
            <div class="lg:col-span-2 space-y-8">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 relative overflow-hidden">
                    <h2 class="text-xl font-semibold mb-4 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                        Espace Ω
                    </h2>
                    
                    <div class="flex justify-center items-center h-[400px]">
                        <svg id="mainSvg" width="300" height="300" viewBox="0 0 300 300" class="overflow-visible drop-shadow-md">
                            <defs>
                                <clipPath id="universeClip">
                                    <rect x="0" y="0" width="300" height="300" rx="8"></rect>
                                </clipPath>
                                <clipPath id="clipA">
                                    <circle id="circleAClip" cx="120" cy="150" r="60"></circle>
                                </clipPath>
                            </defs>

                            <!-- CARRÉ DE L'UNIVERS -->
                            <rect id="universe" x="0" y="0" width="300" height="300" fill="#ffffff" stroke="#cbd5e1" stroke-width="2" rx="8" class="transition-all"></rect>
                            <text id="omegaLabel" x="10" y="25" class="text-[10px] fill-slate-400 font-bold math-font tracking-[0.2em]">AIRE Ω = 1.00</text>
                            
                            <!-- CONTENU ÉVÉNEMENTIEL -->
                            <g id="viewport" class="transition-geom origin-center" clip-path="url(#universeClip)">
                                <circle id="circleA" cx="100" cy="150" r="60" fill="rgba(79, 70, 229, 0.35)" stroke="#4f46e5" stroke-width="2" class="transition-geom"></circle>
                                <circle id="circleB" cx="200" cy="150" r="50" fill="rgba(16, 185, 129, 0.35)" stroke="#10b981" stroke-width="2" class="transition-geom"></circle>
                                
                                <circle id="cInter" cx="200" cy="150" r="50" clip-path="url(#clipA)" fill="rgba(147, 51, 234, 0.7)" class="transition-geom"></circle>
                            </g>
                        </svg>
                    </div>

                    <div id="legend" class="absolute bottom-6 left-6 flex flex-col gap-2 bg-white/90 backdrop-blur p-3 rounded-lg border border-slate-100 text-[10px] font-mono uppercase">
                        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-indigo-500 opacity-40 border border-indigo-600"></div> <span>Événement A</span></div>
                        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-emerald-500 opacity-40 border border-emerald-600"></div> <span>Événement B</span></div>
                        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-purple-600 opacity-80 border border-purple-700"></div> <span>Intersection</span></div>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h2 class="text-xl font-semibold mb-4">Rigueur Géométrique</h2>
                    <div id="explanationText" class="text-slate-600 text-sm leading-relaxed">
                        Pour que deux cercles puissent être totalement séparés dans un carré de $1.0$ d'aire, leurs aires individuelles doivent être modérées. C'est pourquoi les curseurs sont limités à $0.15$ chacun, garantissant une séparation visuelle nette lorsque l'intersection est nulle.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const sliders = {
            a: document.getElementById('sliderA'),
            b: document.getElementById('sliderB'),
            inter: document.getElementById('sliderInter')
        };
        const labels = {
            a: document.getElementById('valA'),
            b: document.getElementById('valB'),
            inter: document.getElementById('valInter')
        };
        const displays = {
            formula: document.getElementById('calcFormula'),
            result: document.getElementById('finalResult'),
            explanation: document.getElementById('explanationText'),
            btn: document.getElementById('toggleBtn')
        };
        const svg = {
            viewport: document.getElementById('viewport'),
            universe: document.getElementById('universe'),
            labelOmega: document.getElementById('omegaLabel'),
            cA: document.getElementById('circleA'),
            cB: document.getElementById('circleB'),
            cAClip: document.getElementById('circleAClip'),
            cInter: document.getElementById('cInter')
        };

        let isConditioned = false;

        function update() {
            let pA = parseFloat(sliders.a.value);
            let pB = parseFloat(sliders.b.value);
            let pInter = parseFloat(sliders.inter.value);

            // Contrainte : P(A ∩ B) <= min(P(A), P(B))
            const maxPossibleInter = Math.min(pA, pB);
            if (pInter > maxPossibleInter) {
                pInter = maxPossibleInter;
                sliders.inter.value = pInter;
            }
            sliders.inter.max = maxPossibleInter;

            labels.a.textContent = pA.toFixed(2);
            labels.b.textContent = pB.toFixed(2);
            labels.inter.textContent = pInter.toFixed(2);

            const res = pB > 0 ? (pInter / pB) : 0;
            displays.formula.textContent = pInter.toFixed(2) + " / " + pB.toFixed(2);
            displays.result.textContent = res.toFixed(3);

            const size = 300;
            const center = 150;
            
            // Calcul exact des rayons : Aire = PI * r^2 = P * (300^2)
            const rA = Math.sqrt((pA * 90000) / Math.PI);
            const rB = Math.sqrt((pB * 90000) / Math.PI);
            
            // Calcul de la distance d entre les centres
            const dMax = rA + rB + 20; // Distance séparée (avec un gap de 20px pour plus de clarté)
            const dMin = Math.abs(rA - rB); // Distance pour intersection maximale
            
            // Ratio de chevauchement (0 = séparés, 1 = l'un dans l'autre)
            const overlapRatio = maxPossibleInter > 0 ? (pInter / maxPossibleInter) : 0;
            const d = dMax - overlapRatio * (dMax - dMin);

            // Calcul des positions horizontales
            let posA = center - d/2;
            let posB = center + d/2;

            // Clamping : Les centres doivent être au moins à 'r' du bord pour rester dans Omega
            if (posA < rA) {
                posA = rA;
                posB = posA + d;
            }
            if (posB > size - rB) {
                posB = size - rB;
                posA = posB - d;
            }

            // Mise à jour SVG
            [svg.cA, svg.cAClip].forEach(el => {
                el.setAttribute('cx', posA);
                el.setAttribute('r', rA);
            });
            [svg.cB, svg.cInter].forEach(el => {
                el.setAttribute('cx', posB);
                el.setAttribute('r', rB);
            });

            if (isConditioned) {
                const scale = 1.8;
                const tx = (center - posB) * scale;
                const ty = 0; 
                
                svg.viewport.style.transform = `scale(${scale}) translate(${tx/scale}px, ${ty}px)`;
                svg.universe.setAttribute('fill', '#f8fafc');
                svg.labelOmega.style.opacity = '0.1';
                svg.cA.style.opacity = '0.05';
                svg.cB.setAttribute('stroke-width', '3');
                displays.explanation.innerHTML = `<div class="bg-emerald-50 p-4 border-l-4 border-emerald-500 text-emerald-900 rounded-r-lg">
                    <strong>Zoom sur B :</strong> L'univers se limite au cercle vert. On calcule la proportion de l'intersection (violet) par rapport à B. 
                    Le résultat <strong>${res.toFixed(3)}</strong> est le rapport des aires.
                </div>`;
            } else {
                svg.viewport.style.transform = `scale(1) translate(0, 0)`;
                svg.universe.setAttribute('fill', '#ffffff');
                svg.labelOmega.style.opacity = '1';
                svg.cA.style.opacity = '1';
                svg.cB.setAttribute('stroke-width', '2');
                displays.explanation.innerHTML = `Les probabilités sont exprimées comme des aires par rapport au carré blanc (Ω = 1.0). Les événements sont limités à $0,15$ pour une meilleure clarté visuelle.`;
            }
        }

        Object.values(sliders).forEach(s => s.addEventListener('input', update));
        
        displays.btn.addEventListener('click', () => {
            isConditioned = !isConditioned;
            if (isConditioned) {
                displays.btn.classList.add('bg-emerald-600', 'text-white');
                displays.btn.classList.remove('bg-slate-200', 'text-slate-700');
                displays.btn.querySelector('span').textContent = "Annuler la condition";
            } else {
                displays.btn.classList.remove('bg-emerald-600', 'text-white');
                displays.btn.classList.add('bg-slate-200', 'text-slate-700');
                displays.btn.querySelector('span').textContent = "Appliquer la condition (Sachant B)";
            }
            update();
        });

        update();
    </script>
</body>
</html>
